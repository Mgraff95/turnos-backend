// ============================================
// TOMADOR DE TURNOS - Schema Prisma v2
// Múltiples rangos horarios por día
// + Reservas múltiples (varios servicios en un bloque continuo)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quién atiende. Cada servicio, rango horario y turno cuelga de una profesional,
// y la disponibilidad se calcula por separado para cada una: dos profesionales
// pueden tener turnos a la misma hora sin bloquearse.
//
// comision_pct_default = null significa que esa profesional ES el estudio: la
// plata de sus turnos es del estudio y no hay nada que liquidarle. Con valor,
// la plata la cobra ella y le debe ese % al estudio.
model Profesional {
  id         Int     @id @default(autoincrement())
  nombre     String
  activo     Boolean @default(true)
  orden      Int     @default(0)
  telefono   String? // para mandarle la liquidación por WhatsApp

  comision_pct_default Decimal? @db.Decimal(5, 2)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  servicios Servicio[]
  horarios  HorarioConfig[]
  bloqueos  BloqueCerrado[]
  turnos    Turno[]

  @@map("profesionales")
}

model Servicio {
  id               Int      @id @default(autoincrement())
  nombre           String
  duracion_minutos Int
  precio_pesos     Decimal  @db.Decimal(10, 2)
  activo           Boolean  @default(true)
  intercalable           Boolean @default(false)
  intercalar_desde_min   Int?
  servicios_compatibles  Int[]   @default([])
  max_simultaneos        Int     @default(2)
  incluye_nota     Boolean  @default(false)
  nota             String?

  // Dueña del servicio. El @default(1) es TEMPORAL: hace el backfill a Daniela
  // de las 18 filas que ya existen. Se quita en el último paso de la migración,
  // para que un turno sin profesional explícita falle en vez de caer en Daniela
  // en silencio.
  profesional_id   Int      @default(1)
  // null = heredar el % de la profesional. 0 = 0% y NO hereda.
  comision_pct     Decimal? @db.Decimal(5, 2)

  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  profesional Profesional @relation(fields: [profesional_id], references: [id])
  turnos      Turno[]
  waitlist    Waitlist[]

  @@index([profesional_id])
  @@map("servicios")
}

model HorarioConfig {
  id                       Int      @id @default(autoincrement())
  dia_semana               Int      // 0=lun, 1=mar, ..., 6=dom (YA NO ES UNIQUE)
  abierto                  Boolean  @default(true)
  hora_inicio              String   @default("09:00")
  hora_fin                 String   @default("18:00")
  espacio_entre_turnos_min Int      @default(10)

  // null = es el horario semanal de siempre, el que vale todos los <dia_semana>.
  // Con fecha = es una excepción para ese día puntual, y REEMPLAZA al semanal:
  // sirve para alargar, para acortar, y para abrir un día normalmente cerrado.
  // Para CERRAR sigue estando bloques_cerrados, que se aplica encima.
  fecha                    DateTime? @db.Date

  // De quién es este rango. Cada profesional tiene su propia agenda y su propio
  // espacio entre turnos. @default(1) temporal, igual que en servicios.
  profesional_id           Int      @default(1)

  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  profesional Profesional @relation(fields: [profesional_id], references: [id])

  @@index([profesional_id, dia_semana])
  @@index([fecha])
  @@map("horarios_config")
}

// Bloqueo de agenda. Si hora_inicio/hora_fin son null, bloquea el DÍA COMPLETO
// (comportamiento original). Si tienen valor, bloquea solo ese rango horario
// dentro del día indicado.
model BloqueCerrado {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @db.Date
  hora_inicio String?  // null = bloquea el día completo
  hora_fin    String?  // null = bloquea el día completo
  motivo      String?

  // Alcance del bloqueo. null = cierra el estudio para TODAS (un feriado, que
  // es el comportamiento de siempre). Con valor, cierra solo esa agenda.
  profesional_id Int?

  created_at  DateTime @default(now())

  profesional Profesional? @relation(fields: [profesional_id], references: [id])

  @@index([profesional_id])
  @@map("bloques_cerrados")
}

// Extras / adicionales ofrecibles sobre un servicio.
// Cada extra tiene su propio precio y tiempo, y se asigna a uno o varios servicios.
model Extra {
  id                  Int      @id @default(autoincrement())
  nombre              String
  descripcion         String?
  precio_pesos        Decimal  @db.Decimal(10, 2)
  precio_variable     Boolean  @default(false)
  minutos_adicionales Int      @default(0)
  servicios_ids       Int[]    @default([]) // IDs de servicios que ofrecen este extra
  destacado           Boolean  @default(false)
  activo              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("extras")
}

model Turno {
  id                Int      @id @default(autoincrement())
  cliente_nombre    String
  cliente_apellido  String
  cliente_telefono  String
  servicio_id       Int
  fecha             DateTime @db.Date
  hora_inicio       String
  hora_fin          String
  estado            String   @default("confirmado")
  pago_realizado    Boolean  @default(false)
  pago_monto        Decimal? @db.Decimal(10, 2)
  pago_tipo         String?  // sena | total
  mp_payment_id     String?  // id del pago en Mercado Pago (traza)
  extras_ids        Int[]    @default([]) // IDs de extras elegidos para este turno
  grupo_reserva     String?  // UUID compartido entre turnos de una misma reserva múltiple (null = turno simple)
  orden_en_grupo    Int?     // posición del servicio dentro del bloque (1, 2, 3...)
  token_acceso      String   @default(uuid())
  token_expires_at  DateTime @default(dbgenerated("NOW() + INTERVAL '30 days'"))
  origen            String   @default("web") // web | manual
  recordatorio_enviado Boolean @default(false)

  // Quién atendió. Redundante respecto de servicio.profesional_id a propósito:
  // la agenda y la liquidación filtran por acá todo el tiempo, y si un servicio
  // cambia de dueña el histórico tiene que quedarse con quien lo hizo.
  // @default(1) temporal, igual que en servicios.
  profesional_id    Int      @default(1)

  // Foto de la plata al momento de reservar. NO se recalculan nunca: si Daniela
  // sube un precio, una liquidación ya compartida tiene que seguir diciendo lo
  // mismo. Nullable porque los turnos que ya existen no las tienen.
  precio_base       Decimal? @db.Decimal(10, 2)
  comision_pct      Decimal? @db.Decimal(5, 2)
  comision_monto    Decimal? @db.Decimal(10, 2)

  // false = no entra en la liquidación (la clienta no vino). El turno sigue
  // confirmado para todo lo demás: ocupó el horario y cuenta en su histórico.
  liquidable        Boolean  @default(true)

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  servicio    Servicio    @relation(fields: [servicio_id], references: [id])
  profesional Profesional @relation(fields: [profesional_id], references: [id])

  @@index([profesional_id, fecha])
  @@index([fecha, estado])
  @@index([cliente_telefono, cliente_apellido])
  @@index([token_acceso])
  @@index([grupo_reserva])
  @@map("turnos")
}

model UsuarioAdmin {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  nombre        String
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now())
  last_login    DateTime?

  @@map("usuarios_admin")
}
model NotaCliente {
  id                Int      @id @default(autoincrement())
  cliente_telefono  String
  texto             String
  created_at        DateTime @default(now())

  @@index([cliente_telefono])
  @@map("notas_clientes")
}
model Waitlist {
  id                Int      @id @default(autoincrement())
  cliente_nombre    String
  cliente_apellido  String
  cliente_telefono  String
  servicio_id       Int
  fecha             DateTime @db.Date
  franja            String   // "manana" o "tarde"
  notificado        Boolean  @default(false)
  activo            Boolean  @default(true)
  created_at        DateTime @default(now())

  servicio Servicio @relation(fields: [servicio_id], references: [id])

  @@index([fecha, franja, activo])
  @@index([cliente_telefono])
  @@map("waitlist")
}

// ============================================
// COBROS / MERCADO PAGO
// ============================================

// Configuracion global de cobros. Fila unica (id = 1).
// cobro_activo = false -> la web reserva sin pedir pago (comportamiento previo a MP).
model ConfigPago {
  id             Int      @id @default(1)
  cobro_activo   Boolean  @default(false)
  sena_monto     Decimal  @default(5000) @db.Decimal(10, 2)
  hold_minutos   Int      @default(12)
  texto_checkout String?
  updated_at     DateTime @updatedAt

  @@map("config_pago")
}

// Clientas que deben abonar el 100% del servicio por adelantado.
// Se gestiona desde el panel admin (ficha de clienta).
model ClienteRestriccion {
  id                  Int      @id @default(autoincrement())
  cliente_telefono    String   @unique
  cliente_nombre      String?
  cliente_apellido    String?
  requiere_pago_total Boolean  @default(true)
  motivo              String?
  activo              Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@index([cliente_telefono])
  @@map("cliente_restricciones")
}

// Hold temporal del slot mientras la clienta paga. NO es un turno:
// la tabla turnos queda intacta hasta que el pago esta aprobado.
model ReservaPendiente {
  id               Int      @id @default(autoincrement())
  external_ref     String   @unique
  cliente_nombre   String
  cliente_apellido String
  cliente_telefono String
  fecha            DateTime @db.Date
  hora_inicio      String
  hora_fin         String
  payload          Json
  // Agenda que este hold congela. El checkout lo setea siempre; null queda solo
  // como comportamiento defensivo para filas viejas (null bloquea a todas), no
  // como caso normal. Sin esto, un pago en curso de Daniela congelaría la
  // agenda de Elsa. Sin relación: es una tabla transitoria.
  profesional_id   Int?
  es_multi         Boolean  @default(false)
  monto            Decimal  @db.Decimal(10, 2)
  tipo_pago        String
  estado           String   @default("activa")
  mp_preference_id String?
  expira_at        DateTime
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([fecha, estado, expira_at])
  @@index([estado])
  @@map("reservas_pendientes")
}

// Registro de todo pago recibido. Auditoria + reembolsos.
model Pago {
  id               Int      @id @default(autoincrement())
  mp_payment_id    String   @unique
  mp_preference_id String?
  external_ref     String?
  cliente_telefono String
  monto            Decimal  @db.Decimal(10, 2)
  tipo             String
  estado           String
  metodo           String?
  grupo_reserva    String?
  turno_ids        Int[]    @default([])
  raw              Json?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  @@index([cliente_telefono])
  @@index([external_ref])
  @@index([created_at])
  @@map("pagos")
}
